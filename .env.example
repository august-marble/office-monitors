# PostHog Configuration
POSTHOG_API_KEY=phx_your_api_key_here
POSTHOG_PROJECT_ID=your_project_id
POSTHOG_HOST=https://app.posthog.com

# Refresh interval in seconds (default: 60)
REFRESH_INTERVAL=60

# Access token for dashboard (generate a random string)
# URL format: https://your-app.vercel.app?token=YOUR_TOKEN_HERE
ACCESS_TOKEN=your-secret-token-here
